<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Resource Include="Assets\TMS_logo.png" />
    <Resource Include="Assets\ScoreboardStudio.ico" />
    <ProjectReference Include="..\ScoreboardStudio.Core\ScoreboardStudio.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ScoreboardStudio</AssemblyName>
    <ApplicationIcon>Assets\ScoreboardStudio.ico</ApplicationIcon>
    <Version>0.6.1</Version>
    <Company>Total Media Sports</Company>
    <Product>TMS Scoreboard Studio</Product>
    <Description>Live scoreboard fields for broadcast graphics by Total Media Sports.</Description>
  </PropertyGroup>

</Project>
