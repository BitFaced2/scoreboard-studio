<Window x:Class="ScoreboardStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TMS Scoreboard Studio" Icon="Assets/TMS_logo.png" Width="1440" Height="940" MinWidth="900" MinHeight="580" WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip" Background="#0D1117" Foreground="#EDF3FA" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"><ScrollViewer Focusable="False" Padding="0"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="Panel" Color="#151C25" />
    <SolidColorBrush x:Key="Muted" Color="#9AAABE" />
    <SolidColorBrush x:Key="Accent" Color="#005EAD" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#263342" />
      <Setter Property="Foreground" Value="#EDF3FA" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Body" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D141D" />
      <Setter Property="Foreground" Value="#EDF3FA" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="BorderBrush" Value="#354454" />
      <Setter Property="Padding" Value="7,6" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#17212C" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DCE6EF" />
      <Setter Property="Margin" Value="0,7" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,6,0,12" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#9AAABE" />
      <Setter Property="Padding" Value="20,14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Body" Background="#151C25" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#8BC7FF" />
                <Setter TargetName="Body" Property="BorderBrush" Value="#ED1824" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#E3EDF7" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Body" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#173A5D" />
                <Setter Property="Foreground" Value="#A8D6FF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#233440" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#26313D">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,20,20" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#1D2631">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="0,0,10,10" />
                <RectangleGeometry Rect="10,10,10,10" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>
  <ScrollViewer x:Name="WindowScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
  <Grid MinWidth="1180" MinHeight="740" Width="{Binding ViewportWidth, ElementName=WindowScroll}" Height="{Binding ViewportHeight, ElementName=WindowScroll}">
    <Grid.RowDefinitions>
      <RowDefinition Height="80" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>
    <Border Background="#10151E" BorderBrush="#ED1824" BorderThickness="0,0,0,3" Padding="18,0">
      <DockPanel VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="_" Click="MinimizeClick" ToolTip="Minimize window" AutomationProperties.Name="Minimize window" Padding="9,6" />
          <Button Content="&#x25A1;" Click="MaximizeClick" ToolTip="Maximize / restore window" AutomationProperties.Name="Maximize or restore window" Padding="9,6" />
          <Button Content="Load setup" Click="LoadClick" />
          <Button Content="Save setup" Click="SaveClick" />
          <Button Content="Save as" Click="SaveAsClick" />
          <Button x:Name="LiveButton" Content="Lock for live" Click="LiveClick" />
          <Button x:Name="OutputButton" Content="Start NDI outputs" Style="{StaticResource Primary}" Click="OutputClick" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Source="Assets/TMS_logo.png" Width="106" Height="63" Stretch="Uniform" Margin="0,0,16,0" ToolTip="Total Media Sports" AutomationProperties.Name="Total Media Sports logo" />
          <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SCOREBOARD STUDIO" FontSize="20" FontWeight="Bold" />
          <TextBlock x:Name="SetupTitle" Text="Live digits. Your graphics." Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" x:Name="SourceControls">
            <TextBlock Text="SOURCE" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
            <ComboBox x:Name="SourceCombo" ToolTip="Available NDI sources" />
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
              <Button Content="Refresh" Click="RefreshClick" />
              <Button Content="Connect" Style="{StaticResource Primary}" Click="ConnectClick" />
            </StackPanel>
            <TextBlock x:Name="DiscoveryText" Text="Scanning for NDI sources…" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,12" />
            <Button Content="Load image or video" Click="LoadMediaClick" Margin="0,0,0,10" />
            <StackPanel x:Name="VideoControls" Visibility="Collapsed" Margin="0,0,0,10">
              <TextBlock x:Name="MediaFileLabel" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PauseVideoButton" Content="Pause" Click="PauseVideoClick" />
                <Button Content="Restart" Click="RestartVideoClick" />
              </StackPanel>
              <CheckBox x:Name="LoopVideo" Content="Loop video" IsChecked="True" Click="LoopVideoClick" />
              <TextBlock x:Name="VideoTime" Foreground="{StaticResource Muted}" FontSize="11" />
            </StackPanel>
            <Border Height="1" Background="#2A3542" Margin="0,0,0,16" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" x:Name="FieldActions" Margin="0,12,0,0">
            <Button x:Name="DrawButton" Content="+ Draw a field" Click="DrawClick" Margin="0,0,0,7" />
            <Button Content="Remove selected field" Click="RemoveClick" Margin="0,0,0,7" />
            <TextBlock Text="Draw around the entire field, leaving room for every digit." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0" />
          </StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="YOUR FIELDS" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
            <TextBlock x:Name="EmptyFieldsText" DockPanel.Dock="Top" Text="Connect a source, then draw fields or load a saved setup." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
            <ListBox x:Name="FieldList" Background="Transparent" BorderThickness="0" SelectionChanged="FieldSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
          </DockPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="SignalBanner" Background="#17304A" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
          <TextBlock x:Name="SignalText" Text="Choose a source" TextWrapping="Wrap" Foreground="#A8D6FF" />
        </Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="{StaticResource Panel}" BorderThickness="0">
          <TabItem Header="01   Fields">
            <Grid Margin="16">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel x:Name="DetectionControls">
                <TextBlock Text="Separate your scoreboard" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="Select a box to move it. Drag its lower-right corner to resize." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14" />
                <WrapPanel>
                  <Button x:Name="PerspectiveButton" Content="Straighten camera" Click="PerspectiveClick" />
                  <Button x:Name="DetectButton" Content="Find fields" Click="DetectClick" />
                  <Button x:Name="AcceptDetection" Content="Replace fields with suggestions" Click="AcceptDetectionClick" Visibility="Collapsed" Style="{StaticResource Primary}" />
                  <Button x:Name="UndoDetection" Content="Undo detection" Click="UndoDetectionClick" Visibility="Collapsed" />
                  <Button x:Name="StabilizeButton" Content="Stabilize camera" Click="StabilizeClick"/><Button x:Name="ReferenceButton" Content="Set reference" Click="SetReferenceClick" IsEnabled="False"/>
                </WrapPanel>


                <WrapPanel x:Name="DetectionOptions" Margin="0,10,0,0">
                  <TextBlock Text="Look for" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox x:Name="DetectionIsolation" Width="150" SelectedIndex="0" Margin="0,0,12,0"><ComboBoxItem Content="Bright colors"/><ComboBoxItem Content="White highlights"/></ComboBox>
                  <TextBlock Text="Cutoff" VerticalAlignment="Center"/>
                  <Slider x:Name="DetectionThreshold" Minimum="0" Maximum="254" Value="130" Width="100" Margin="7,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ElementName=DetectionThreshold, Path=Value, StringFormat={}{0:0}}" VerticalAlignment="Center"/>
                </WrapPanel>
                <StackPanel x:Name="PerspectiveControls" Visibility="Collapsed" Margin="0,12,0,0">
                  <TextBlock Text="Drag a dot or its label directly. The picture is frozen while editing. Arrow keys fine-tune the selected corner; Shift moves 10 pixels." TextWrapping="Wrap" Foreground="#E7BE73" Margin="0,0,0,8"/>
                  <WrapPanel><TextBlock Text="Corrected size" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="PerspectiveWidth" Width="58" Text="1280"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="PerspectiveHeight" Width="58" Text="720" Margin="0,0,10,0"/><Button Content="Apply" Style="{StaticResource Primary}" Click="ApplyPerspectiveClick"/><Button Content="Cancel" Click="CancelPerspectiveClick"/><Button Content="Reset correction" Click="ResetPerspectiveClick"/></WrapPanel>
                </StackPanel>
                <WrapPanel><TextBlock x:Name="StabilizationStatus" Text="Stabilization off" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,9,14,0"/><TextBlock x:Name="PerspectiveStatus" Text="Perspective correction off" Foreground="{StaticResource Muted}" Margin="0,9,0,0" FontSize="11"/></WrapPanel>
                <TextBlock x:Name="DetectionHint" Foreground="#E7BE73" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0" />
              </StackPanel>
              <Border Grid.Row="1" Background="#080B10" CornerRadius="6" Margin="0,16" ClipToBounds="True">
                <Grid>
                <Viewbox Stretch="Uniform" Margin="18" SizeChanged="PreviewSizeChanged">
                  <Grid x:Name="VideoSurface" Width="1280" Height="720">
                    <Image x:Name="SourceImage" Stretch="Fill" />
                    <Canvas x:Name="BoxCanvas" Background="Transparent" Focusable="True" KeyDown="CornerKeyDown" MouseLeftButtonDown="CanvasDown" MouseMove="CanvasMove" MouseLeftButtonUp="CanvasUp" LostMouseCapture="CanvasLostCapture" />
                  </Grid>
                </Viewbox>
                <StackPanel x:Name="EmptySourcePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="350" IsHitTestVisible="False">
                  <TextBlock Text="Connect your scoreboard" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                  <TextBlock Text="Select an NDI source and click Connect, or use Load image or video to open your own footage." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
                </Grid>
              </Border>
              <DockPanel Grid.Row="2">
                <Button DockPanel.Dock="Right" Content="Cleanup  →" Click="CleanupTabClick" />
                <TextBlock x:Name="FrameInfo" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
              </DockPanel>
            </Grid>
          </TabItem>
          <TabItem Header="02   Cleanup">
            <Grid Margin="18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Keep the digits. Lose the background." FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Select a field, then adjust its cleanup on the right." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="ORIGINAL CROP" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                <Border Grid.Row="1" Background="#080B10" CornerRadius="6" Padding="20">
                  <Image x:Name="OriginalPreview" Stretch="Uniform" />
                </Border>
              </Grid>
              <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                  <ComboBox x:Name="PreviewBackground" DockPanel.Dock="Right" Width="120" SelectedIndex="0" SelectionChanged="BackgroundChanged">
                    <ComboBoxItem Content="Checkerboard" />
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Light" />
                  </ComboBox>
                  <TextBlock Text="CLEANED PREVIEW" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
                <Border x:Name="CleanPreviewBorder" Grid.Row="1" Background="{StaticResource Checker}" CornerRadius="6" Padding="20">
                  <Image x:Name="CleanPreview" Stretch="Uniform" />
                </Border>
              </Grid>
              <TextBlock Grid.Row="3" Text="Enlarged for editing. Check the final size in your vMix scorebug." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0" />
            </Grid>
          </TabItem>
          <TabItem Header="03   Outputs">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="18">
                <TextBlock Text="Ready for your scorebug" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="Start NDI outputs, then add each field in vMix using Add Input → NDI. Position these inputs as layers over your scorebug artwork." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" />
                <Border Background="#17304A" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                  <TextBlock Text="Outputs include transparency. Your GT title stays in vMix; these live fields sit over it." Foreground="#A8D6FF" TextWrapping="Wrap" />
                </Border>
                <ItemsControl x:Name="OutputCards">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#0F161F" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="#8BC7FF" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                          </DockPanel>
                          <Border Background="{StaticResource Checker}" Height="76" Margin="0,10" Padding="8">
                            <Image Source="{Binding Image}" Stretch="Uniform" />
                          </Border>
                          <TextBlock Text="{Binding Output}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="#151C25" CornerRadius="6" Margin="0,12,0,0" Padding="12">
          <TextBlock x:Name="Notice" Text="Connect an NDI source, load your image or video, or open a saved setup." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
        </Border>
      </Grid>
      <Border Grid.Column="4" Background="{StaticResource Panel}" CornerRadius="8" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Inspector">
            <TextBlock Text="FIELD SETTINGS" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,14" />
            <TextBlock Text="Name" Margin="0,0,0,6" />
            <TextBox x:Name="FieldName" MaxLength="60" LostFocus="RenameField" KeyDown="NameKeyDown" />
            <CheckBox x:Name="FieldEnabled" Content="Include in NDI outputs" Click="CleanupChanged" />
            <TextBlock Text="CROP POSITION (%)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,8" />
            <UniformGrid Columns="4">
              <StackPanel>
                <TextBlock Text="Left" FontSize="11" />
                <TextBox x:Name="CropX" Margin="0,4,4,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Top" FontSize="11" />
                <TextBox x:Name="CropY" Margin="0,4,4,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Width" FontSize="11" />
                <TextBox x:Name="CropW" Margin="0,4,4,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Height" FontSize="11" />
                <TextBox x:Name="CropH" Margin="0,4,0,0" />
              </StackPanel>
            </UniformGrid>
            <Button Content="Apply crop" Click="ApplyCropClick" Margin="0,8,0,14" />
            <Border Height="1" Background="#2A3542" Margin="0,0,0,14" />
            <CheckBox x:Name="RemoveBackground" Content="Remove background" Click="CleanupChanged" />
            <TextBlock Text="Isolate digits using" Margin="0,4,0,6"/>
            <ComboBox x:Name="IsolationMode" SelectedIndex="0" SelectionChanged="ColorChanged" Margin="0,0,0,10"><ComboBoxItem Content="Bright colors"/><ComboBoxItem Content="White highlights"/></ComboBox>
            <DockPanel>
              <TextBlock Text="Background cutoff" />
              <TextBlock x:Name="ThresholdValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
            </DockPanel>
            <Slider x:Name="Threshold" Minimum="0" Maximum="254" Value="90" ValueChanged="SliderChanged" />
            <DockPanel>
              <TextBlock Text="Edge softness" />
              <TextBlock x:Name="SoftnessValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
            </DockPanel>
            <Slider x:Name="Softness" Minimum="1" Maximum="128" Value="32" ValueChanged="SliderChanged" />
            <DockPanel>
              <TextBlock Text="Digit brightness" />
              <TextBlock x:Name="BrightnessValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
            </DockPanel>
            <Slider x:Name="Brightness" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.05" ValueChanged="SliderChanged" />
            <TextBlock Text="Digit color" Margin="0,0,0,6" />
            <ComboBox x:Name="DigitColor" SelectedIndex="0" SelectionChanged="ColorChanged">
              <ComboBoxItem Content="White" />
              <ComboBoxItem Content="Original" />
              <ComboBoxItem Content="Custom" />
            </ComboBox>
            <TextBox x:Name="CustomColor" Text="#FFFFFF" Margin="0,7,0,10" LostFocus="CustomColorChanged" ToolTip="Custom color in #RRGGBB format" />
            <DockPanel Margin="0,8,0,0">
              <TextBlock Text="Edge thickness" />
              <TextBlock x:Name="ThicknessValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
            </DockPanel>
            <Slider x:Name="Thickness" Minimum="-2" Maximum="3" Value="0" ValueChanged="SliderChanged" />
            <CheckBox x:Name="SmoothEdges" Content="Smooth edges" Click="CleanupChanged" />
            <CheckBox x:Name="Speckles" Content="Remove isolated speckles" Click="CleanupChanged" />
            <Button Content="Apply cleanup to all fields" Click="ApplyAllClick" Margin="0,14,0,7" />
            <Button Content="Reset cleanup" Click="ResetCleanupClick" Margin="0,0,0,7" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#121922" BorderBrush="#283441" BorderThickness="0,1,0,0" Padding="24,0">
      <DockPanel VerticalAlignment="Center">
        <TextBlock x:Name="OutputStatus" DockPanel.Dock="Right" Text="OUTPUTS STOPPED" Foreground="{StaticResource Muted}" />
        <TextBlock DockPanel.Dock="Left" Text="TOTAL MEDIA SPORTS" FontWeight="Bold" Foreground="#8BC7FF" Margin="0,0,24,0" />
        <TextBlock x:Name="RuntimeStatus" Text="Starting…" Foreground="{StaticResource Muted}" />
      </DockPanel>
    </Border>
  </Grid>
  </ScrollViewer>
</Window>
